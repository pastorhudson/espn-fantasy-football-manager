# Copy to .env for local development and generate a unique SECRET_KEY.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
ESPN_LEAGUE_ID=0
ESPN_TEAM_ID=0
ESPN_SEASON=2026
ESPN_S2=
ESPN_SWID=
AUTOPILOT_ENABLED=false
SHADOW_MODE=true
# Production: DEBUG=false, PostgreSQL DATABASE_URL, real host, random 50+ character key.
# Enable only behind a trusted proxy that replaces X-Forwarded-Proto:
TRUST_PROXY_SSL_HEADER=false
CSRF_TRUSTED_ORIGINS=

# Days of unreferenced snapshot history retained by scheduled runs
SNAPSHOT_RETENTION_DAYS=30

# Free ESPN NFL schedule and Sleeper player/trending context (no key required).
FREE_DATA_ENABLED=true
